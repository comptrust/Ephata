# ==============================================================================
# EPHATA CONSULTING GROUP - CONFIGURATION SERVEUR LWS (Apache / cPanel)
# ==============================================================================

# 1. Activation du moteur de réécriture
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirection automatique vers HTTPS (Recommandé sur LWS avec SSL Let's Encrypt)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Routage Single Page Application (SPA React / HTML5)
  # Si le fichier ou dossier demandé n'existe pas, renvoyer vers index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Compression GZIP pour une vitesse maximale sur mobile (Sénégal & Afrique)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 3. Cache navigateur pour un chargement instantané
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4. En-têtes de sécurité
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Protection des fichiers sensibles
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>
